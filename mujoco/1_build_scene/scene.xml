    <!-- One motor, two fingers. Onshape exports each finger as its own joint,
         but the linkage means the follower is not free - it tracks the driver.
         polycoef is [offset, ratio, 0, 0, 0]:  follower = offset + ratio*driver

         solref/solimp are stiffened deliberately. MuJoCo equality constraints
         are SOFT by default, and the default let the two fingers differ by
         4.2 degrees at mid-travel; these values bring that to 0.005 degrees. -->
    <joint joint1="revolute_11" joint2="revolute_10"
           polycoef="0 1 0 0 0"
           solref="0.004 1" solimp="0.99 0.9999 0.0001 0.5 2"/>
    <joint joint1="revolute_20" joint2="revolute_19"
           polycoef="0 -1 0 0 0"
           solref="0.004 1" solimp="0.99 0.9999 0.0001 0.5 2"/>
